    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "url = 'https://github.com/alura-cursos/Pandas/blob/main/emissoes_CO2.xlsx?raw=True'\n",
        "\n",
        "dados = pd.read_excel(url, sheet_name='emissoes_C02')\n",
        "percapita = pd.read_excel(url, sheet_name='emissoes_percapita')\n",
        "fontes = pd.read_excel(url, sheet_name='fontes')"
      ],
      "metadata": {
        "id": "CirTD3OxEEuf"
      },
      "execution_count": 32,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "🧹 3. Limpeza de dados"
      ],
      "metadata": {
        "id": "3d1t8UGkFg9d"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# substituir [NONE] por NaN\n",
        "fontes = fontes.replace('[NONE]', pd.NA)\n",
        "\n",
        "# converter colunas numéricas\n",
        "colunas = ['Total', 'Carvão', 'Oléo', 'Gás', 'Cimento', 'Queima', 'Outro']\n",
        "\n",
        "for col in colunas:\n",
        "    fontes[col] = pd.to_numeric(fontes[col], errors='coerce')\n",
        "\n",
        "# remover valores nulos importantes\n",
        "dados = dados.dropna(subset=['Total'])\n",
        "\n",
        "# remover \"Global\" para análise por país\n",
        "dados = dados[dados['País'] != 'Global']"
      ],
      "metadata": {
        "id": "nz3wa4y1EdyC"
